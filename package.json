{
  "name": "tax-engine",
  "version": "0.1.0",
  "description": "Open-source US federal and state tax engine with spec-driven unit tests for every IRS scenario",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "node ./scripts/run-web-dev.mjs",
    "dev:engine": "tsx watch src/index.ts",
    "dev:web": "node ./scripts/run-web-dev.mjs",
    "build": "tsc",
    "build:web": "pnpm --filter @tax-engine/web build",
    "self-host:up": "docker compose --env-file .env.docker up --build",
    "self-host:down": "docker compose --env-file .env.docker down",
    "self-host:logs": "docker compose --env-file .env.docker logs -f web",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:web": "pnpm --filter @tax-engine/web test:e2e",
    "test:pa": "vitest run tests/engine/state/pa-*.test.ts tests/edge-cases/pa-full-return.test.ts tests/public-api.test.ts tests/spec/spec-validator.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "pnpm --filter @tax-engine/web typecheck",
    "calculate": "tsx src/cli.ts",
    "calculate:watch": "tsx watch src/cli.ts",
    "spec:validate": "node --import tsx src/spec-validator.ts",
    "spec:validate:pa": "node --import tsx src/spec-validator.ts --include=state/pa-",
    "spec:validate:oh": "node --import tsx src/spec-validator.ts --scope=state/oh",
    "spec:validate:ca": "node --import tsx src/spec-validator.ts --scope=state/ca",
    "spec:validate:il": "node --import tsx src/spec-validator.ts --scope=state/il",
    "spec:validate:nj": "node --import tsx src/spec-validator.ts --scope=state/nj",
    "spec:validate:ny": "node --import tsx src/spec-validator.ts --scope=state/ny",
    "spec:validate:wa": "node --import tsx src/spec-validator.ts --scope=state/wa",
    "eval:models": "node --import tsx ./scripts/benchmark-model-stack.ts",
    "eval:models:sync": "node --import tsx ./scripts/benchmark-model-stack.ts --sync",
    "eval:models:check": "node --import tsx ./scripts/benchmark-model-stack.ts --check",
    "eval:models:live-summary": "node --import tsx ./scripts/benchmark-model-stack.ts --live-summary",
    "sample-docs:fetch": "tsx scripts/fetch-sample-tax-docs.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "AGPL-3.0-only",
  "keywords": [
    "tax",
    "irs",
    "1040",
    "tax-engine",
    "federal-tax",
    "state-tax"
  ],
  "dependencies": {
    "decimal.js": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.12",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^10.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
