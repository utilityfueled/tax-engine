[
  {
    "Config": {
      "Entrypoint": [
        "/bin/bash"
      ],
      "Cmd": [
        "/qualification-build.sh"
      ],
      "Env": [
        "LC_ALL=C",
        "LANG=C",
        "EXPECTED_ARCH=amd64",
        "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/postgresql/16/bin",
        "GOSU_VERSION=1.19",
        "PG_MAJOR=16",
        "PG_VERSION=16.16-1.pgdg12+1",
        "PGDATA=/var/lib/postgresql/data",
        "DEBIAN_FRONTEND=noninteractive"
      ]
    },
    "HostConfig": {
      "NetworkMode": "none",
      "Privileged": false,
      "ReadonlyRootfs": false,
      "CapAdd": null,
      "CapDrop": null,
      "SecurityOpt": null
    },
    "Mounts": [
      {
        "Type": "bind",
        "Source": "/fixture/authenticated/inputs",
        "Destination": "/qualification-inputs",
        "RW": false
      },
      {
        "Type": "tmpfs",
        "Source": "",
        "Destination": "/var/lib/postgresql/data",
        "RW": true
      }
    ]
  }
]
