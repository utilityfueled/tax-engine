# Provider keys alone do not enable AI. Reviewed task qualification and rollout
# configuration are required; self-hosting works with all keys blank.
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GOOGLE_API_KEY=
TAX_ENGINE_DEPLOYMENT_MODE=self-host
# Local preview default only. Hosted production must use postgres-s3.
TAX_ENGINE_HOSTED_PERSISTENCE_BACKEND=preview-memory
TAX_ENGINE_HOSTED_PREVIEW_ACTOR_ID=
TAX_ENGINE_HOSTED_PREVIEW_ACTOR_LABEL=
TAX_ENGINE_BILLING_MODE=test
# Local preview default only. Hosted production must use the public app origin.
TAX_ENGINE_APP_URL=http://localhost:3000
TAX_ENGINE_CANONICAL_HOSTNAME=vivalatax.com
NEXT_PUBLIC_TAX_ENGINE_REPO_URL=https://github.com/utilityfueled/tax-engine
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PLUS_MONTHLY=
STRIPE_PRICE_ID_AI_HELPER_TOP_UP=
TAX_ENGINE_AI_HELPER_INCLUDED_BUDGET_CENTS=1000
TAX_ENGINE_AI_HELPER_TOP_UP_CREDIT_CENTS=1000
TAX_ENGINE_AI_HELPER_TOP_UP_PRICE_CENTS=1500
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional namespace when sharing one Redis database across environments.
TAX_ENGINE_RATE_LIMIT_PREFIX=tax-engine:ratelimit
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN override. If blank, the public DSN is reused on the server.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Production hosted mode should use PlanetScale Postgres (or equivalent) and
# `TAX_ENGINE_HOSTED_PERSISTENCE_BACKEND=postgres-s3`. Raw tax forms remain
# local-first and are not stored in durable hosted storage.
DATABASE_URL=postgresql://tax_engine:tax_engine_dev_only@127.0.0.1:5432/tax_engine

# The current workspace remains local-first and persists in browser storage.
NEXT_TELEMETRY_DISABLED=1
